{
	"name": "skill-icons",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"scripts": {
		"dev": "node build.js && miniflare --watch",
		"build": "node build.js",
		"deploy": "node build.js && wrangler publish",
		"icons:generate": "node scripts/generate-themed-icons.js",
		"icons:dry-run": "node scripts/generate-themed-icons.js --dry-run",
		"icons:batch": "node scripts/generate-and-build-icons.js",
		"icons:radius": "node scripts/generate-radius-icons.js",
		"icons:radius:batch": "node scripts/generate-and-build-radius-icons.js"
	},
	"devDependencies": {
		"@cloudflare/wrangler": "^1.19.8",
		"miniflare": "^2.3.0",
		"prettier": "^2.5.1"
	}
